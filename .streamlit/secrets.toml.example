# Copy this file to .streamlit/secrets.toml (gitignored -- never commit the
# real one) for local development, and paste the same key into the deployed
# Streamlit Cloud app's Settings -> Secrets. Also set
# PUBLIC_STRATEGIES_DATABASE_URL as a GitHub Actions repo secret (same
# value) for the weekly recompute job -- see
# scripts/update_saved_strategies.py.
#
# Can be a separate Supabase project, or the SAME one as the private
# systematic-momentum-investing-portfolio portal (this repo's db_public.py
# prefixes every table `public_` specifically so the two don't collide).
# Either way, this database is reachable by anyone who uses the public
# app's Saved Strategies feature, so it must never hold anything
# sensitive -- no broker credentials, no real trading state.
#
# Connection string format for a Supabase project -- use the POOLER
# string (Connect -> "Transaction pooler" or "Session pooler" in the
# Supabase dashboard), not the direct connection host: Supabase's direct
# DB hostnames are IPv6-only, and many networks (home ISPs especially)
# don't have working IPv6, which fails with a DNS-looking error that's
# actually a connectivity one.
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Remember to URL-encode special characters in the password (e.g. @ -> %40).
public_strategies_database_url = "postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres"
